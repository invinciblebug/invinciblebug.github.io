---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../lib/constants';
import { slugToUrl } from '../../lib/slug';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Blog',
  description: 'Blog posts, updates, and release notes by Invincible Bug.',
  url: SITE.url + '/blog',
  author: { '@type': 'Person', name: SITE.author },
  publisher: {
    '@type': 'Organization',
    name: SITE.title,
    logo: {
      '@type': 'ImageObject',
      url: SITE.url + SITE.authorAvatar,
    },
  },
};

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);
---

<BaseLayout
  title="Blog"
  description="Blog posts, updates, and release notes by Invincible Bug."
  keywords={['blog', 'posts', 'articles', 'software', 'open source', 'Smart Simulation', 'Sims 4']}
  schema={schema}
>
  <div data-swup>
    <div class="mb-8">
      <h1 class="text-3xl font-bold">Blog</h1>
      <p class="text-neutral-500 dark:text-neutral-400 mt-2">Blog posts, updates, and release notes.</p>
    </div>

    {posts.length > 0 && (
      <div class="mb-6">
        <input
          id="search-input"
          type="text"
          placeholder="Search posts..."
          class="w-full px-4 py-2.5 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 text-neutral-900 dark:text-neutral-100 placeholder-neutral-400 dark:placeholder-neutral-500 focus:outline-none focus:border-neutral-400 dark:focus:border-neutral-600 transition-colors"
        />
      </div>
    )}

    {posts.length === 0 ? (
      <div class="text-center py-16">
        <svg class="w-16 h-16 mx-auto text-neutral-300 dark:text-neutral-600 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
        </svg>
        <p class="text-neutral-500 dark:text-neutral-400 text-lg">No blog posts published yet.</p>
      </div>
    ) : (
      <div id="post-list" class="space-y-4">
        {posts.map((post) => (
          <article class="post-item p-5 rounded-xl border border-neutral-200 dark:border-neutral-800 hover:border-neutral-400 dark:hover:border-neutral-600 transition-colors" data-title={post.data.title.toLowerCase()} data-description={post.data.description.toLowerCase()} data-tags={post.data.tags.join(' ').toLowerCase()}>
            <a href={slugToUrl(post.id)} class="block">
              <time class="text-sm text-neutral-500 dark:text-neutral-400" datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <h2 class="text-lg font-semibold mt-1 mb-2 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">{post.data.title}</h2>
              <p class="text-sm text-neutral-600 dark:text-neutral-400 mb-3">{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {post.data.tags.map((tag) => (
                    <span class="px-2 py-0.5 text-xs rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400">{tag}</span>
                  ))}
                </div>
              )}
            </a>
          </article>
        ))}
      </div>
    )}
  </div>
</BaseLayout>

<script>
  const input = document.getElementById('search-input') as HTMLInputElement;
  const items = document.querySelectorAll('.post-item');

  input?.addEventListener('input', () => {
    const q = input.value.toLowerCase();
    items.forEach((item) => {
      const title = item.getAttribute('data-title') || '';
      const desc = item.getAttribute('data-description') || '';
      const tags = item.getAttribute('data-tags') || '';
      const match = title.includes(q) || desc.includes(q) || tags.includes(q);
      (item as HTMLElement).style.display = match ? '' : 'none';
    });
  });
</script>
