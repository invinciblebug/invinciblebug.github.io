---
import { Astronav, MenuItems, MenuIcon, StickyHeader } from 'astro-navbar';
import { Image } from 'astro:assets';
import { SITE } from '../lib/constants';
import favicon from '../assets/favicon.svg';

const links = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
];
---

<StickyHeader
  class="sticky top-0 z-50 transition-all"
  scrollY={50}
  defaultClass="py-4 border-transparent"
  activeClass="py-3 bg-white/80 dark:bg-neutral-950/80 border-neutral-200 dark:border-neutral-800 backdrop-blur-md"
>
  <div class="max-w-5xl mx-auto px-4 flex items-center justify-between">
    <Astronav closeOnClick>
      <div class="flex items-center justify-between w-full lg:w-auto">
        <a href="/" class="flex items-center gap-2 font-bold text-lg hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
          <Image src={favicon} alt="" class="w-8 h-8 rounded-full border border-neutral-300 dark:border-neutral-600" width={32} height={32} />
          {SITE.title}
        </a>
        <MenuIcon class="w-5 h-5 text-neutral-700 dark:text-neutral-300 lg:hidden" />
      </div>
      <MenuItems class="hidden lg:flex">
        <ul class="flex items-center gap-1 lg:ml-auto">
          {links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class:list={[
                  'px-3 py-2 rounded-lg text-sm font-medium transition-colors',
                  (href === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(href))
                    ? 'text-neutral-900 dark:text-white'
                    : 'text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white',
                ]}
              >
                {label}
              </a>
            </li>
          ))}
          <li>
            <button
              id="theme-toggle"
              type="button"
              class="ml-1 p-2 rounded-lg text-neutral-500 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
              aria-label="Toggle theme"
            >
              <svg class="w-5 h-5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
              <svg class="w-5 h-5 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
              </svg>
            </button>
          </li>
        </ul>
      </MenuItems>
    </Astronav>
  </div>
</StickyHeader>

<script>
  import { toggleTheme, initTheme } from '../lib/store';

  initTheme();
  document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
</script>
